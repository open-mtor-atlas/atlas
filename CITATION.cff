cff-version: 1.2.0
message: "If you use this dataset, please cite it as below."
title: "Oliver's mTOR Atlas"
type: dataset
authors:
  - family-names: "Barton"
    given-names: "Oliver"
abstract: "A curated, evidence-graded database of mTOR pathway research: peer-reviewed primary studies rated by evidence tier (A = systematic review/meta-analysis, B = human trial, C = animal model, D = mechanistic/in-vitro/review), linked to a knowledge graph of genes, diseases and interventions, plus AI-identified knowledge gaps and testable hypotheses."
url: "https://mtor-atlas.org"
repository-code: "https://github.com/open-mtor-atlas/atlas"
license: CC-BY-4.0
doi: 10.5281/zenodo.22059963
identifiers:
  - type: doi
    value: 10.5281/zenodo.22059963
    description: "The concept DOI for the collection containing all versions of Oliver's mTOR Atlas."
  - type: doi
    value: 10.5281/zenodo.22059964
    description: "The versioned DOI for v1.0.0 of Oliver's mTOR Atlas."
keywords:
  - mTOR
  - mTORC1
  - mTORC2
  - autophagy
  - rapamycin
  - longevity
  - aging biology
  - evidence-based research
version: "1.0.0"
date-released: "2026-08-22"
